generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles/statuses are plain strings rather than native enums (this schema
// used to target SQLite, which has no enum support, and there's no benefit
// to changing it now). The allowed values are the single source of truth in
// src/lib/constants.ts and are enforced at the API layer with zod.

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("SALES_REP") // "ADMIN" | "SALES_REP"
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?

  leads             Lead[]             @relation("AssignedLeads")
  activities        Activity[]
  followUps         FollowUp[]
  paymentLinks      PaymentLink[]
  whatsAppTemplates WhatsAppTemplate[]
  heartbeatLogs     HeartbeatLog[]
  invoices          Invoice[]
}

// One row per heartbeat ping (throttled to roughly one per minute of active
// use in the API route) -- lets the admin see actual time-in-app per day,
// not just the single most-recent lastActiveAt timestamp.
model HeartbeatLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model WhatsAppTemplate {
  id          String   @id @default(cuid())
  name        String
  body        String
  imageUrl    String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById String?
}

model LeadSource {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Lead {
  id              String    @id @default(cuid())
  name            String
  contactName     String?
  email           String?
  phone           String?
  company         String?
  website         String?
  source          String?
  value           Float     @default(0)
  status          String    @default("NEW") // see LEAD_STATUSES
  temperature     String? // "HOT" | "WARM" | "COLD"
  statusChangedAt DateTime  @default(now())
  closedAt        DateTime?

  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])
  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities   Activity[]
  followUps    FollowUp[]
  paymentLinks PaymentLink[]
  invoices     Invoice[]

  @@index([status])
  @@index([assignedToId])
  @@index([temperature])
}

model Activity {
  id     String  @id @default(cuid())
  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String
  user   User?   @relation(fields: [userId], references: [id])
  userId String?
  type   String // "NOTE" | "CALL" | "STATUS_CHANGE"

  // populated when type = CALL
  callNumber  Int?
  callOutcome String? // see CALL_OUTCOMES

  // populated when type = STATUS_CHANGE
  fromStatus String?
  toStatus   String?

  note      String?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model FollowUp {
  id             String    @id @default(cuid())
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId         String
  user           User?     @relation(fields: [userId], references: [id])
  userId         String?
  dueAt          DateTime
  note           String?
  completed      Boolean   @default(false)
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([leadId])
  @@index([dueAt])
}

model PaymentLink {
  id          String    @id @default(cuid())
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdById String?
  razorpayId  String    @unique
  shortUrl    String
  amount      Float
  description String?
  status      String    @default("CREATED") // "CREATED" | "PAID" | "EXPIRED" | "CANCELLED"
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([leadId])
  @@index([razorpayId])
}

// Invoices issued in the business's name (see src/lib/invoices.ts). Numbered
// sequentially per Indian financial year (Apr-Mar), e.g. "CB/2026-27/0001",
// as GST rules require -- InvoiceCounter hands out the next number inside the
// same transaction that creates the invoice, so numbers never skip or repeat.
// Invoices are never deleted or edited once issued, only cancelled, so the
// monthly/yearly registers always account for every number.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  financialYear String // "2026-27"
  sequence      Int
  invoiceDate   DateTime
  source        String // "MANUAL" | "RAZORPAY" | "API"
  status        String   @default("PAID") // "PAID" | "UNPAID" | "CANCELLED"

  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerGstin   String?

  // [{ description, quantity, rate }] -- amounts in rupees
  items     Json
  subtotal  Float
  taxRate   Float  @default(0) // percent, e.g. 18
  taxAmount Float  @default(0)
  total     Float
  currency  String @default("INR")

  paymentMethod     String?
  razorpayPaymentId String? @unique
  notes             String?

  // Where the PDF lives on the server's disk, relative to INVOICE_DIR
  pdfPath String?

  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@unique([financialYear, sequence])
  @@index([invoiceDate])
  @@index([status])
}

model InvoiceCounter {
  financialYear String @id
  lastSequence  Int    @default(0)
}
