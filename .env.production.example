# Production env for the Docker/VPS deployment (see deploy/setup-vps.sh,
# which generates this file for you automatically — you shouldn't normally
# need to copy or edit this by hand).

# Postgres connection string (Neon, Supabase, RDS, a self-hosted instance —
# anything reachable from this server). Using the same database your Vercel
# deployment (if any) uses is fine and means no data migration when you move
# which server runs the app.
DATABASE_URL=""

# Random secret used to sign session tokens. Generate your own with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public URL of the site. http://<server-ip> until you add a domain, then
# https://yourdomain.com once Caddy has a certificate for it.
NEXTAUTH_URL=""

# Initial admin account, created on first start (safe to leave in place
# afterwards; the seed script skips creation if the account already exists).
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional: SMTP settings for follow-up reminder emails. Leave blank to skip
# email reminders (the in-app Follow-ups page still works either way).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CRM Reminders <reminders@example.com>"

# Shared secret required to call /api/cron/reminders.
CRON_SECRET=""

# Shared secret required to call /api/external/leads (used by the Leads
# Finder tool, or any other internal script, to push leads in). Leave blank
# to disable that endpoint entirely. Generate with: openssl rand -hex 24
EXTERNAL_LEADS_SECRET=""

# Optional: Razorpay, for generating payment links from a lead. Leave blank
# to disable. RAZORPAY_WEBHOOK_SECRET is optional but recommended — without
# it, payment status only updates when someone clicks "Check status".
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Invoices (Invoices page, admin only). Business details printed on every
# invoice -- blank = the built-in CodeBunny defaults (A8, Flower Valley, VIP
# Road, Raipur - 492001 / info@codebunny.net). INVOICE_COMPANY_ADDRESS spans
# lines with "|". Invoice numbers look like CB/2026-27/0001 (prefix /
# Indian financial year / sequence).
INVOICE_COMPANY_NAME="CodeBunny"
INVOICE_COMPANY_ADDRESS=""
INVOICE_COMPANY_EMAIL=""
INVOICE_COMPANY_PHONE=""
INVOICE_COMPANY_WEBSITE=""
INVOICE_COMPANY_GSTIN=""
INVOICE_PREFIX="CB"
# Optional: path to a PNG/JPG logo on the server, e.g. /app/invoices/logo.png
INVOICE_LOGO_PATH=""
INVOICE_FOOTER="Thank you for your business!"
# GST is off (0) for now. Set a rate, e.g. 18, once registered: the New
# invoice form then shows GST fields, and Razorpay amounts are treated as
# GST-inclusive at this rate.
INVOICE_DEFAULT_TAX_RATE="0"
# Razorpay payments become invoices automatically (scheduled sync every 15
# minutes on the VPS, plus instantly via the webhook if configured). Set to
# "false" to stop the webhook doing it.
RAZORPAY_AUTO_INVOICE="true"
