# Postgres connection string. For local dev, either run a throwaway Postgres
# in Docker:
#   docker run -d -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16-alpine
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
# or just point this at a free Neon/Supabase database (same one you'll use in
# production is fine for a small team).
DATABASE_URL=""

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional: SMTP settings for follow-up reminder emails.
# If left blank, reminders still show up in-app under "Follow-ups" but no email is sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CRM Reminders <reminders@example.com>"

# Shared secret required to call /api/cron/reminders (set the same value in your
# cron provider, e.g. Vercel Cron, as a header: `Authorization: Bearer <value>`)
CRON_SECRET="change-this-too"

# Optional: Razorpay, for generating payment links from a lead and tracking
# whether they've been paid. Get these from Razorpay Dashboard → Settings →
# API Keys. Leave blank to disable the payment links feature entirely.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional but recommended: enables real-time "paid" status updates via a
# webhook instead of relying on the manual "Check status" button. Set up in
# Razorpay Dashboard → Settings → Webhooks, pointing at
# https://yourdomain.com/api/webhooks/razorpay with the "payment_link.paid"
# event enabled, and paste the same secret you enter there.
RAZORPAY_WEBHOOK_SECRET=""

# Optional: Website Audit tool (/audit). Works with none of these set, but:
# - ANTHROPIC_API_KEY (console.anthropic.com) adds an AI-written report and a
#   tailored walkthrough-video script based on the site's screenshot.
# - PAGESPEED_API_KEY (free, Google Cloud Console → enable "PageSpeed
#   Insights API" → create API key) adds Google Lighthouse speed scores;
#   without it Google rate-limits the shared anonymous quota.
# - ELEVENLABS_API_KEY (elevenlabs.io) adds an AI voiceover to exported videos.
#   ELEVENLABS_VOICE_ID optionally picks a different voice.
ANTHROPIC_API_KEY=""
PAGESPEED_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
