# Postgres connection string. For local dev, either run a throwaway Postgres
# in Docker:
#   docker run -d -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16-alpine
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
# or just point this at a free Neon/Supabase database (same one you'll use in
# production is fine for a small team).
DATABASE_URL=""

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional: SMTP settings for follow-up reminder emails.
# If left blank, reminders still show up in-app under "Follow-ups" but no email is sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CRM Reminders <reminders@example.com>"

# Shared secret required to call /api/cron/reminders (set the same value in your
# cron provider, e.g. Vercel Cron, as a header: `Authorization: Bearer <value>`)
CRON_SECRET="change-this-too"
